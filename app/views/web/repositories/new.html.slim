.gq-page
  header.gq-page-heading
    .gq-page-heading__copy
      p.gq-eyebrow = t('gq_ui.common.workspace')
      h1.gq-page__title = t('views_i18n.repositories.new.title')
      p.gq-page__lede = t('gq_ui.repositories.add_intro')
    = link_to t('gq_ui.common.back'), repositories_path, class: 'gq-button gq-button--outline'

  section.gq-panel.gq-repo-form
    - if flash[:alert].present?
      .gq-notice.gq-notice--danger role="alert" = flash[:alert]

    = form_with model: @repository, url: repositories_path, local: true, data: { turbo: false } do |form|
      - if @repository.errors.any?
        .gq-notice.gq-notice--danger role="alert"
          ul
            - @repository.errors.full_messages.each do |message|
              li = message

      .gq-form-stack(
        data-controller="repository-search"
        data-repository-search-count-template-value=t('views_i18n.repositories.new.search_count', shown: '__SHOWN__', total: '__TOTAL__')
      )
        label.gq-form-label for="github_repository_search" = t('views_i18n.repositories.new.search_label')
        input#github_repository_search.gq-field(
          type="search"
          autocomplete="off"
          placeholder=t('views_i18n.repositories.new.search_placeholder')
          data-repository-search-target="query"
          data-action="input->repository-search#filter"
        )

        - repository_options = @github_repositories.map { |repo| [repo.full_name, repo.id] }
        = form.label :github_id, t('views_i18n.repositories.new.github_label'), class: 'gq-form-label'
        = form.select :github_id,
                      options_for_select(repository_options, @repository.github_id),
                      { include_blank: true },
                      class: 'gq-field',
                      data: { repository_search_target: 'select' }
        p.gq-form-hint data-repository-search-target="count" aria-live="polite"
          = t('views_i18n.repositories.new.search_count', shown: @github_repositories.size, total: @github_repositories.size)

      .gq-repo-form__actions
        = form.submit t('views_i18n.repositories.new.submit'), class: 'gq-button'
