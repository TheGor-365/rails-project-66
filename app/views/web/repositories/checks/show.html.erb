<h1>Check</h1>

<% if defined?(@check) && @check.present? %>
  <p>Status: <strong><%= @check.status %></strong></p>

  <% if @check.respond_to?(:short_commit_id) && @check.short_commit_id.present? %>
    <p>Commit: <%= @check.short_commit_id %></p>
  <% end %>

  <% if @check.output.present? %>
    <pre><%= @check.output %></pre>
  <% end %>
<% else %>
  <p>Check not found</p>
<% end %>
