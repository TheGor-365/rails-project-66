.mt-4.mb-5.pb-5
  .container
    .p-4.align-items-center.border.shadow.bg-white.rounded-3
      .mb-4
        h1

      = link_to t('views_i18n.repositories.check.back_to_repository'),
                repository_path(@repository),
                class: 'btn btn-primary mb-4'

      h1 = t('views_i18n.repositories.check.title', id: @check.id)

      - short = check_short_commit_id(@check)
      - url = check_github_commit_url(@check)

      table.table
        tr
          td = t('views_i18n.repositories.check.created_at')
          td = l @check.created_at, format: :long
        tr
          td = t('views_i18n.repositories.check.status')
          td = check_status_text(@check)
        tr
          td = t('views_i18n.repositories.check.passed')
          td
            - unless @check.passed.nil?
              = @check.passed
        tr
          td = t('views_i18n.repositories.check.violations_count')
          td = @check.violations_count
        tr
          td = t('views_i18n.repositories.check.commit_id')
          td
            - if short.present? && url.present?
              = link_to short,
                        url,
                        target: '_blank',
                        rel: 'noopener'

      - offenses_by_file = @check.offenses_by_file

      - if offenses_by_file.present?
        table.table.table-hover.mb-5
          thead
            tr
              th = t('views_i18n.repositories.check.message')
              th = t('views_i18n.repositories.check.rule')
              th = t('views_i18n.repositories.check.location')
          tbody
            - offenses_by_file.each do |file|
              tr
                td colspan="3"
                  - if @check.short_commit_id.present? && file[:path].present?
                    = link_to file[:path],
                              "https://github.com/#{@repository.full_name}/tree/#{short}/#{file[:path]}",
                              target: '_blank',
                              rel: 'noopener'
                  - else
                    = file[:path]

              - file[:offenses].each do |offense|
                tr
                  td = offense[:message]
                  td = offense[:rule]
                  td
                    - if offense[:line].present? && offense[:column].present?
                      = "#{offense[:line]}:#{offense[:column]}"
                    - elsif offense[:line].present?
                      = offense[:line]
      - elsif @check.output.present?
        pre.mt-4 = @check.output
