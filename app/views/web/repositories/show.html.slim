.gq-page
  nav.gq-crumbs aria-label=t('gq_ui.common.breadcrumb')
    = link_to t('views_i18n.repositories.index.title'), repositories_path
    i.bi.bi-chevron-right aria-hidden="true"
    span.gq-break-anywhere = @repository.full_name

  header.gq-page-heading
    .gq-page-heading__copy
      p.gq-eyebrow = t('gq_ui.repositories.detail_label')
      h1.gq-page__title.gq-break-anywhere = @repository.full_name
      p.gq-page__lede = t('gq_ui.repositories.history_intro')
    = button_to t('views_i18n.repositories.show.run_check'), repository_checks_path(@repository), class: 'gq-button', form: { data: { turbo: false } }

  .gq-repository-meta
    .gq-panel
      p.gq-metric__label = t('views_i18n.repositories.show.language')
      strong = @repository.language_text
    .gq-panel
      p.gq-metric__label = t('views_i18n.repositories.show.created_at')
      strong = l @repository.created_at, format: :short
    .gq-panel
      p.gq-metric__label = t('views_i18n.repositories.show.updated_at')
      strong = l @repository.updated_at, format: :short

  section.gq-section
    .gq-section-heading
      h2 = t('gq_ui.repositories.check_history')
      span.gq-count = @checks.size

    - if @checks.any?
      .gq-panel.gq-table-panel
        .gq-check-list
          - @checks.each do |check|
            = link_to repository_check_path(@repository, check), class: 'gq-check-list__item' do
              span.gq-check-list__name
                strong = t('views_i18n.repositories.check.title', id: check.id)
                small = l check.created_at, format: :short
              = render 'shared/ui/check_status', check: check
              - if check_short_commit_id(check).present?
                code.gq-check-list__sha = check_short_commit_id(check)
              i.bi.bi-arrow-up-right.gq-check-list__arrow aria-hidden="true"
    - else
      .gq-panel.gq-empty
        i.bi.bi-clock-history.gq-empty__icon aria-hidden="true"
        p = t('views_i18n.repositories.show.checks_empty')
