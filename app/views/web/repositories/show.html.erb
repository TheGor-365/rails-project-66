<h1>Repository</h1>

<% if defined?(@repository) && @repository.present? %>
  <p><strong><%= @repository.full_name.presence || @repository.name %></strong></p>
<% else %>
  <p>Repository not found</p>
<% end %>

<% checks = defined?(@checks) ? @checks : [] %>

<h2>Checks</h2>
<% if checks.present? %>
  <ul>
    <% checks.each do |check| %>
      <li>
        <%= check.status %>
        <% short = check_short_commit_id(check) %>
<% if short.present? %>
  (<%= short %>)
<% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No checks</p>
<% end %>
