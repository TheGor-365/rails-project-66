.container.py-5
  h1.mb-3 = t('views_i18n.home.title')
  h2.h5.mb-4 = t('views_i18n.home.subtitle')

  - if current_user
    p.mb-3
      = "#{t('views_i18n.home.signed_in_as')} "
      strong = current_user.email
      | .

    .mb-3.d-flex.gap-2
      = link_to t('views_i18n.home.repositories'), repositories_path, class: 'btn btn-primary'
      = button_to t('views_i18n.home.logout'),
                  logout_path,
                  method: :delete,
                  data: { turbo: false },
                  class: 'btn btn-outline-secondary'
  - else
    = button_to t('views_i18n.home.login_github'),
                '/auth/github',
                method: :post,
                data: { turbo: false },
                class: 'btn btn-primary'
