= t('views_i18n.mailer.check_report.repository_result', repository: @repository.full_name)
= "\n\n"
= t('views_i18n.mailer.check_report.status', status: check_status_text(@check))
= "\n"
= t('views_i18n.mailer.check_report.errors', count: @check.violations_count || 0)
= "\n\n"
= t('views_i18n.mailer.check_report.check_id', id: @check.id)
= "\n"
= t('views_i18n.mailer.check_report.commit_id', commit_id: @check.commit_id.presence || "—")
= "\n\n"
= t('views_i18n.mailer.check_report.details')
= "\n"
= repository_check_url(@repository, @check)
= "\n\n"
= "--\n"
= t('views_i18n.mailer.check_report.signature')
= "\n"
